# Database
POSTGRES_DB=parcezza
POSTGRES_USER=parcezza
POSTGRES_PASSWORD=parcezza

# Backend Spring datasource (overrides use container name 'db')
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/parcezza
SPRING_DATASOURCE_USERNAME=parcezza
SPRING_DATASOURCE_PASSWORD=parcezza

# pgAdmin web UI
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin
