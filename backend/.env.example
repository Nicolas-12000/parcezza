# =========================================================================
# Parcezza Backend - Environment Variables Template (.env.example)
# Copy this file to '.env' and fill in your actual local configuration values.
# =========================================================================

# Database Connection
POSTGRES_URL=jdbc:postgresql://localhost:5432/parcezza
POSTGRES_USER=parcezza
POSTGRES_PASSWORD=your_secure_password_here

# Security / Authentication
JWT_SECRET=change-me-please-change-change-me-please-change
JWT_EXPIRATION_MS=3600000
