# =========================================================================
# Parcezza Backend - Environment Variables Template (.env.example)
# Copy this file to '.env' and fill in your actual local configuration values.
# =========================================================================

# Database Connection
POSTGRES_URL=jdbc:postgresql://localhost:5432/parcezza
POSTGRES_USER=parcezza
POSTGRES_PASSWORD=your_secure_password_here

# Security / Authentication
JWT_SECRET=change-me-please-change-change-me-please-change
JWT_EXPIRATION_MS=3600000

# CORS Configuration
# Comma-separated list of allowed origins. Use '*' to allow all for testing, or set your S3 website URL.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://your-s3-bucket-website-url.amazonaws.com
